; Legacy nested project config; the repository root project.godot is canonical.
[application]

config/name="Rat Trainer"
run/main_scene="res://src/scenes/Main.tscn"

[display]

window/size/width=1024
window/size/height=768

[render]

rendering/quality/drivers/gles3/texture_filter=1

